{
  "info": {
    "description": "REST API of **MecaTrack**, a booking and vehicle-tracking system for a car repair workshop.\n\n* **Errors** always use the same JSON body: `{\"code\": \"...\", \"message\": \"...\", \"details\": ...}`.\n* **Authentication** is a session cookie. In Swagger UI, call `POST /auth/login` first\n  (for example with `carlos.owner@tallermecanico.com` / `test1234`, the test owner listed in the README);\n  the browser keeps the cookie and sends it on the following requests.\n* **Roles**: reading the catalog is public; creating, replacing or deleting services\n  requires the `owner` or `admin` role.",
    "contact": {
      "name": "MecaTrack team - Universidad Manuela Beltran"
    },
    "title": "MecaTrack API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Session management (pre-existing routes)."
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Flask session cookie returned by POST /auth/login."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error identifier in snake_case.",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation of the error.",
            "example": "Service 42 was not found"
          },
          "details": {
            "description": "Extra context, e.g. validation errors per field. May be null.",
            "example": {
              "service_id": 42
            },
            "nullable": true
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "Service": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "integer",
            "readOnly": true,
            "description": "Unique identifier of the service.",
            "example": 1
          },
          "business_id": {
            "type": "integer",
            "readOnly": true,
            "description": "Identifier of the workshop that offers the service.",
            "example": 1
          },
          "service_name": {
            "type": "string",
            "description": "Unique service name within the workshop.",
            "example": "Cambio de aceite"
          },
          "description": {
            "type": "string",
            "description": "What the service includes.",
            "example": "Cambio de aceite y filtro",
            "nullable": true
          },
          "estimated_duration_minutes": {
            "type": "integer",
            "description": "Estimated time the vehicle occupies a bay, in minutes.",
            "example": 45
          },
          "base_price": {
            "type": "integer",
            "description": "Base price in Colombian pesos (COP), without decimals.",
            "example": 80000
          },
          "status": {
            "type": "string",
            "description": "Catalog status: 'active' services can be booked.",
            "example": "active"
          }
        },
        "additionalProperties": false
      },
      "ServiceInput": {
        "type": "object",
        "properties": {
          "service_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Service name (2-100 characters). Must be unique within the workshop, case-insensitive.",
            "example": "Cambio de pastillas de freno"
          },
          "description": {
            "type": "string",
            "default": null,
            "maxLength": 500,
            "description": "Optional description of what the service includes (max 500 characters).",
            "example": "Reemplazo de pastillas delanteras y revision de discos",
            "nullable": true
          },
          "estimated_duration_minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 600,
            "description": "Estimated duration in minutes (5-600).",
            "example": 90
          },
          "base_price": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Base price in COP, integer between 0 and 100,000,000.",
            "example": 150000
          },
          "status": {
            "type": "string",
            "default": "active",
            "enum": [
              "active",
              "inactive"
            ],
            "description": "Catalog status, 'active' (default) or 'inactive'.",
            "example": "active"
          }
        },
        "required": [
          "base_price",
          "estimated_duration_minutes",
          "service_name"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in",
        "description": "Starts a session and sets the `session` cookie used by the protected endpoints. This is a pre-existing route, so its errors use the legacy `{\"error\": \"...\"}` body.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Account email.",
                    "example": "carlos.owner@tallermecanico.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Account password.",
                    "example": "test1234"
                  }
                }
              },
              "example": {
                "email": "carlos.owner@tallermecanico.com",
                "password": "test1234"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session started; the response sets the `session` cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Confirmation message.",
                      "example": "Sesión iniciada"
                    },
                    "user_id": {
                      "type": "integer",
                      "description": "Id of the logged-in user.",
                      "example": 1
                    },
                    "role": {
                      "type": "string",
                      "description": "Role of the user.",
                      "example": "owner"
                    }
                  }
                },
                "example": {
                  "message": "Sesión iniciada",
                  "user_id": 1,
                  "role": "owner"
                }
              }
            }
          },
          "400": {
            "description": "Email or password missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message in Spanish (legacy format of the /auth routes).",
                      "example": "Credenciales inválidas"
                    }
                  }
                },
                "example": {
                  "error": "Correo y contraseña son obligatorios"
                }
              }
            }
          },
          "401": {
            "description": "Wrong credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message in Spanish (legacy format of the /auth routes).",
                      "example": "Credenciales inválidas"
                    }
                  }
                },
                "example": {
                  "error": "Credenciales inválidas"
                }
              }
            }
          },
          "403": {
            "description": "The account is inactive.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message in Spanish (legacy format of the /auth routes).",
                      "example": "Credenciales inválidas"
                    }
                  }
                },
                "example": {
                  "error": "Tu cuenta está inactiva"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out",
        "description": "Ends the current session. Pre-existing route (legacy error format).",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session closed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Confirmation message.",
                      "example": "Sesión cerrada"
                    }
                  }
                },
                "example": {
                  "message": "Sesión cerrada"
                }
              }
            }
          },
          "401": {
            "description": "There was no active session.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Error message in Spanish (legacy format of the /auth routes).",
                      "example": "Credenciales inválidas"
                    }
                  }
                },
                "example": {
                  "error": "Debes iniciar sesión para acceder a este recurso"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/services": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "description": "Filter by status: 'active' (default), 'inactive' or 'all'.",
            "schema": {
              "type": "string",
              "default": "active",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "example": "active"
            },
            "required": false
          }
        ],
        "responses": {
          "422": {
            "description": "Invalid query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "validation_error",
                  "message": "The request body is invalid",
                  "details": {
                    "status": [
                      "Must be one of: active, inactive, all."
                    ]
                  }
                }
              }
            }
          },
          "200": {
            "description": "The services matching the filter, ordered by id.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Service"
                  }
                },
                "example": [
                  {
                    "service_id": 1,
                    "business_id": 1,
                    "service_name": "Cambio de aceite",
                    "description": "Cambio de aceite y filtro",
                    "estimated_duration_minutes": 45,
                    "base_price": 80000,
                    "status": "active"
                  },
                  {
                    "service_id": 2,
                    "business_id": 1,
                    "service_name": "Alineacion y balanceo",
                    "description": "Alineacion de llantas y balanceo",
                    "estimated_duration_minutes": 60,
                    "base_price": 120000,
                    "status": "active"
                  }
                ]
              }
            }
          }
        },
        "summary": "List services",
        "description": "Returns the service catalog ordered by id. By default only active\nservices are returned; use `status=all` to include inactive ones.\nPublic endpoint, no authentication required.",
        "tags": [
          "Services"
        ]
      },
      "post": {
        "responses": {
          "422": {
            "description": "The body failed validation; `details` lists the errors per field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "validation_error",
                  "message": "The request body is invalid",
                  "details": {
                    "service_name": [
                      "Shorter than minimum length 2."
                    ],
                    "base_price": [
                      "Must be greater than or equal to 0 and less than or equal to 100000000."
                    ]
                  }
                }
              }
            }
          },
          "409": {
            "description": "Another service of the workshop already uses that name (case-insensitive).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "duplicate_service_name",
                  "message": "A service named 'Cambio de aceite' already exists",
                  "details": {
                    "service_name": "Cambio de aceite",
                    "existing_service_id": 1
                  }
                }
              }
            }
          },
          "403": {
            "description": "The session role is not `owner` or `admin`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "forbidden",
                  "message": "Your role is not allowed to perform this action",
                  "details": {
                    "required_roles": [
                      "owner",
                      "admin"
                    ],
                    "your_role": "client"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No active session. Log in with POST /auth/login first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "unauthorized",
                  "message": "Authentication required: log in via POST /auth/login",
                  "details": null
                }
              }
            }
          },
          "201": {
            "description": "The service was created; the body is the stored resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Service"
                },
                "example": {
                  "service_name": "Cambio de pastillas de freno",
                  "description": "Reemplazo de pastillas delanteras y revision de discos",
                  "estimated_duration_minutes": 90,
                  "base_price": 150000,
                  "status": "active",
                  "service_id": 3,
                  "business_id": 1
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceInput"
              },
              "example": {
                "service_name": "Cambio de pastillas de freno",
                "description": "Reemplazo de pastillas delanteras y revision de discos",
                "estimated_duration_minutes": 90,
                "base_price": 150000,
                "status": "active"
              }
            }
          }
        },
        "summary": "Create a service",
        "description": "Adds a new service to the catalog of the authenticated user's\nworkshop. `service_name`, `estimated_duration_minutes` and\n`base_price` are required; `status` defaults to `active`.\nRequires an `owner` or `admin` session (cookie from POST /auth/login).",
        "tags": [
          "Services"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    },
    "/api/v1/services/{service_id}": {
      "get": {
        "responses": {
          "404": {
            "description": "No service exists with the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "not_found",
                  "message": "Service 42 was not found",
                  "details": {
                    "service_id": 42
                  }
                }
              }
            }
          },
          "200": {
            "description": "The requested service.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Service"
                },
                "example": {
                  "service_id": 1,
                  "business_id": 1,
                  "service_name": "Cambio de aceite",
                  "description": "Cambio de aceite y filtro",
                  "estimated_duration_minutes": 45,
                  "base_price": 80000,
                  "status": "active"
                }
              }
            }
          }
        },
        "summary": "Get a service",
        "description": "Returns a single service by its id, whether it is active or inactive.\nPublic endpoint, no authentication required.",
        "tags": [
          "Services"
        ]
      },
      "put": {
        "responses": {
          "422": {
            "description": "The body failed validation; `details` lists the errors per field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "validation_error",
                  "message": "The request body is invalid",
                  "details": {
                    "service_name": [
                      "Shorter than minimum length 2."
                    ],
                    "base_price": [
                      "Must be greater than or equal to 0 and less than or equal to 100000000."
                    ]
                  }
                }
              }
            }
          },
          "409": {
            "description": "Another service of the workshop already uses that name (case-insensitive).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "duplicate_service_name",
                  "message": "A service named 'Cambio de aceite' already exists",
                  "details": {
                    "service_name": "Cambio de aceite",
                    "existing_service_id": 1
                  }
                }
              }
            }
          },
          "403": {
            "description": "The session role is not `owner` or `admin`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "forbidden",
                  "message": "Your role is not allowed to perform this action",
                  "details": {
                    "required_roles": [
                      "owner",
                      "admin"
                    ],
                    "your_role": "client"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No active session. Log in with POST /auth/login first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "unauthorized",
                  "message": "Authentication required: log in via POST /auth/login",
                  "details": null
                }
              }
            }
          },
          "404": {
            "description": "No service exists with the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "not_found",
                  "message": "Service 42 was not found",
                  "details": {
                    "service_id": 42
                  }
                }
              }
            }
          },
          "200": {
            "description": "The service after the replacement.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Service"
                },
                "example": {
                  "service_name": "Cambio de pastillas de freno",
                  "description": "Reemplazo de pastillas delanteras y revision de discos",
                  "estimated_duration_minutes": 90,
                  "base_price": 165000,
                  "status": "active",
                  "service_id": 3,
                  "business_id": 1
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceInput"
              },
              "example": {
                "service_name": "Cambio de pastillas de freno",
                "description": "Reemplazo de pastillas delanteras y revision de discos",
                "estimated_duration_minutes": 90,
                "base_price": 165000,
                "status": "active"
              }
            }
          }
        },
        "summary": "Replace a service",
        "description": "Replaces every editable field of the service. This is a full\nreplacement, not a partial update: omitted optional fields go back to\ntheir defaults. To retire a service that already has appointments,\nsend `status: inactive`. Requires an `owner` or `admin` session.",
        "tags": [
          "Services"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "delete": {
        "responses": {
          "409": {
            "description": "The service is referenced by appointments and cannot be deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "service_has_appointments",
                  "message": "Service 1 has 3 appointment(s) and cannot be deleted",
                  "details": {
                    "service_id": 1,
                    "appointments": 3
                  }
                }
              }
            }
          },
          "403": {
            "description": "The session role is not `owner` or `admin`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "forbidden",
                  "message": "Your role is not allowed to perform this action",
                  "details": {
                    "required_roles": [
                      "owner",
                      "admin"
                    ],
                    "your_role": "client"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No active session. Log in with POST /auth/login first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "unauthorized",
                  "message": "Authentication required: log in via POST /auth/login",
                  "details": null
                }
              }
            }
          },
          "404": {
            "description": "No service exists with the given id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "not_found",
                  "message": "Service 42 was not found",
                  "details": {
                    "service_id": 42
                  }
                }
              }
            }
          },
          "204": {
            "description": "The service was deleted. The response has no body."
          }
        },
        "summary": "Delete a service",
        "description": "Permanently deletes a service that has never been booked. If any\nappointment references it the API answers 409, because deleting it\nwould orphan those appointments; deactivate it with PUT\n(`status: inactive`) instead. Requires an `owner` or `admin` session.",
        "tags": [
          "Services"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "service_id",
          "description": "Identifier of the service.",
          "example": 1,
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ]
    }
  },
  "openapi": "3.0.3"
}
