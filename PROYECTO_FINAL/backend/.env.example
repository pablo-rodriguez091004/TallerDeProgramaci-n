FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-secreta-aleatoria

# postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:tu_contrasena@127.0.0.1:5432/taller_mecanico

# Opcional: base para las pruebas (debe terminar en _test). Si no se define,
# se usa DATABASE_URL apuntando a taller_mecanico_test.
# TEST_DATABASE_URL=postgresql://postgres:tu_contrasena@127.0.0.1:5432/taller_mecanico_test

# Asistente IA (Google Gemini). Crea la key en https://aistudio.google.com/apikey
# NUNCA subas la key real: backend/.env esta en .gitignore.
GEMINI_API_KEY=
# Modelo (ver https://ai.google.dev/gemini-api/docs/models). Ej: gemini-3.5-flash-lite
GEMINI_MODEL=
# Opcionales (valores por defecto)
# AI_TIMEOUT_SECONDS=20
# AI_MAX_RETRIES=2
# AI_RETRY_BASE_SECONDS=1
# AI_MAX_CALLS_PER_HOUR=20
